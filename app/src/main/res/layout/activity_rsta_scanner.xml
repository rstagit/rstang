<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_telegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_telegram_hint"
                android:textColor="@color/rsta_scanner_telegram_text"
                android:textSize="11sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="4dp" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rsta_scanner_label_cidr"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_ip_range_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/rsta_scanner_btn_ip_range_settings"
                    android:textSize="10sp"
                    android:backgroundTint="@color/rsta_scanner_btn_neutral" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_cidr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_rsta_scanner_input"
                android:hint="@string/rsta_scanner_hint_cidr"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:inputType="textMultiLine"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="start|top"
                android:textDirection="ltr"
                android:scrollbars="vertical"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_hint_cidr_multi"
                android:textColor="?android:attr/textColorTertiary"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_label_config"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/et_config"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_rsta_scanner_input"
                android:hint="@string/rsta_scanner_hint_config"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:inputType="textMultiLine"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="start|top"
                android:textDirection="ltr"
                android:scrollbars="vertical"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_hint_config_note"
                android:textColor="?android:attr/textColorTertiary"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_label_ports"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_rsta_scanner_input"
                android:paddingVertical="1dp"
                android:layout_marginBottom="2dp">

                <CheckBox
                    android:id="@+id/cb_port_443"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="443"
                    android:checked="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:textDirection="ltr"
                    android:buttonTint="@color/rsta_scanner_checkbox_tint" />

                <CheckBox
                    android:id="@+id/cb_port_2053"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2053"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:textDirection="ltr"
                    android:buttonTint="@color/rsta_scanner_checkbox_tint" />

                <CheckBox
                    android:id="@+id/cb_port_8443"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="8443"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:textDirection="ltr"
                    android:buttonTint="@color/rsta_scanner_checkbox_tint" />

                <CheckBox
                    android:id="@+id/cb_port_2087"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2087"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:textDirection="ltr"
                    android:buttonTint="@color/rsta_scanner_checkbox_tint" />

            </LinearLayout>

            <EditText
                android:id="@+id/et_custom_ports"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_rsta_scanner_input"
                android:hint="@string/rsta_scanner_hint_custom_ports"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:inputType="text"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:gravity="start|center_vertical"
                android:textDirection="ltr"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_hint_custom_ports_note"
                android:textColor="?android:attr/textColorTertiary"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />


            <Button
                android:id="@+id/btn_scan"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_start"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="@color/rsta_scanner_btn_scan" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_found_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/rsta_scanner_found_count"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>


        
        <LinearLayout
            android:id="@+id/group_copy_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_copy_all_ips"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_copy_all_ips"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_neutral"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_copy_all_configs"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_copy_all_configs"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_neutral" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/group_top10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_top10_ping"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_top10_ping"
                android:textSize="10sp"
                android:backgroundTint="@color/rsta_scanner_btn_top10"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rsta_scanner_label_count"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="9sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_speed_count_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/rsta_scanner_btn_neutral" />

            <TextView
                android:id="@+id/tv_speed_count_value"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_rsta_scanner_input"
                android:text="20"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textDirection="ltr"
                android:layout_marginHorizontal="2dp" />

            <Button
                android:id="@+id/btn_speed_count_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/rsta_scanner_btn_neutral" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_top10_rstang"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:text="@string/rsta_scanner_btn_add_top10_rstang"
            android:textSize="11sp"
            android:backgroundTint="@color/rsta_scanner_btn_add_rstang"
            android:visibility="gone"
            android:layout_marginBottom="2dp" />


        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_speed_test"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_speed_test"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_speed_test"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_stop_speed_test"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_stop_speed_test"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_speed_stop"
                android:visibility="gone" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/group_speed_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btn_copy_speed_results"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_copy_speed_results"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_copy_results"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_copy_speed_ips"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/rsta_scanner_btn_copy_speed_ips"
                android:textSize="11sp"
                android:backgroundTint="@color/rsta_scanner_btn_copy_ips" />
        </LinearLayout>


        <TextView
            android:id="@+id/tv_speed_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/rsta_scanner_speed_progress_text"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tv_no_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

    </LinearLayout>

</LinearLayout>